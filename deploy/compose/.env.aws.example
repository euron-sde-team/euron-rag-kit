# Real AWS resources for `make up-aws`. Values come from the Terraform outputs of
# infra/terraform/envs/aws-dev (or your own bucket, key and queue).
AWS_REGION=us-east-1
S3_BUCKET=ragkit-dev-corpus
S3_KMS_KEY_ID=alias/ragkit-dev
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/ragkit-dev-jobs

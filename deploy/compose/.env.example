# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
RAGKIT_SESSION_SECRET=replace-with-output-of-make-env
RAGKIT_API_KEY_PEPPER=replace-with-output-of-make-env
RAGKIT_DEMO_PASSWORD=replace-with-output-of-make-env

# Optional: model answers and model grading instead of the offline answerer and grader
# RAGKIT_LLM_PROVIDER=ollama            # or openai: any OpenAI-compatible API
# RAGKIT_LLM_MODEL=llama3.2
# RAGKIT_OLLAMA_URL=http://host.docker.internal:11434
# RAGKIT_LLM_BASE_URL=https://api.openai.com/v1
# RAGKIT_LLM_API_KEY=

# Optional overrides
# RAGKIT_PRODUCT_NAME=Euron RAGKit
# RAGKIT_LOG_LEVEL=info
# RAGKIT_URL_FETCH_ALLOW_PRIVATE=false
# RAGKIT_WEB_PORT=3160
# RAGKIT_API_PORT=8160
# RAGKIT_PG_PORT=5456
# RAGKIT_REDIS_PORT=6416
# RAGKIT_FLOCI_PORT=4616
